rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function listData(listId) {
      return get(/databases/$(database)/documents/lists/$(listId)).data;
    }

    function isMember(listId) {
      return signedIn() && request.auth.uid in listData(listId).members;
    }

    match /lists/{listId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'members', 'inviteCode', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'ownerId', 'members', 'inviteCode', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('[0-9a-f]{32}')
        && request.resource.data.createdAt == request.time;

      // A new user can join only with the secret in the shared invitation code.
      // The update may add only the caller to members and store the proof.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinProof'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.size() <= 50
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members
        && request.resource.data.joinProof == resource.data.inviteCode;

      allow delete: if false;

      match /items/{itemId} {
        allow get, list: if isMember(listId);

        allow create: if isMember(listId)
          && request.resource.data.keys().hasOnly(['name', 'checked', 'deleted', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasAll(['name', 'checked', 'deleted', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.checked == false
          && request.resource.data.deleted == false
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isMember(listId)
          && resource.data.deleted == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'checked', 'deleted', 'updatedBy', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 200
          && request.resource.data.checked is bool
          && request.resource.data.deleted is bool
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;

        // Soft deletion keeps a tombstone so an offline client cannot recreate it.
        allow delete: if false;
      }
    }
  }
}
